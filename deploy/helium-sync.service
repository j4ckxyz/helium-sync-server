# systemd unit. Install:
#   sudo install -m755 helium-sync /usr/local/bin/
#   sudo cp helium-sync.service /etc/systemd/system/ && sudo systemctl enable --now helium-sync
#   journalctl -u helium-sync    → shows the first invite code
# Admin commands use the same data directory:
#   sudo -u helium-sync HELIUM_SYNC_DATA=/var/lib/helium-sync helium-sync invite
[Unit]
Description=Helium Sync server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/helium-sync serve --addr 127.0.0.1:8080 --public-url https://sync.example.com --trust-proxy
Environment=HELIUM_SYNC_DATA=/var/lib/helium-sync
User=helium-sync
DynamicUser=yes
StateDirectory=helium-sync
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
